# Supabase project settings > API. Anon key is safe to expose to the browser;
# it's still bound by RLS. Service role key bypasses RLS — server-only, never
# ship it to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# https://finnhub.io free-tier API key, used only by the US ingestion cron.
FINNHUB_API_KEY=

# Random secret shared with Vercel Cron to authorize calls to /api/cron/*.
# Generate with: openssl rand -hex 32
# Set the same value as an env var named CRON_SECRET in the Vercel project —
# Vercel then sends it automatically as `Authorization: Bearer <value>` on
# every cron invocation.
CRON_SECRET=
